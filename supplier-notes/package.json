{
  "name": "supplier-notes",
  "private": true,
  "version": "1.8.1",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:build": "vite build && electron-builder --win",
    "electron:publish": "vite build && electron-builder --win --publish always",
    "electron:start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test electron/storage.test.cjs electron/security.test.cjs && node --experimental-strip-types --test src/utils/product.test.mjs src/utils/followUpLinks.test.mjs src/utils/dates.test.mjs src/utils/markdown.test.mjs src/utils/transcriptImport.test.mjs src/utils/noteSections.test.mjs src/store/persistence.test.mjs && node --test src/store/store.test.mjs"
  },
  "build": {
    "appId": "com.fractal.supplier-notes",
    "productName": "HiveMind",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HiveMind"
    },
    "publish": {
      "provider": "github",
      "owner": "diskuskastaren",
      "repo": "HiveMind"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bubble-menu": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-typography": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.474.0",
    "pe-library": "^0.4.1",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.14.8",
    "resedit": "^1.7.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "zustand": "^5.0.0"
  }
}
